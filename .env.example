# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration
# Set MONGODB_URI to connect to external MongoDB Atlas or local daemon.
# If omitted or unavailable, backend falls back to embedded mongodb-memory-server automatically!
MONGODB_URI=mongodb://localhost:27017/supportly_ai

# Security & Authentication
JWT_SECRET=supportly_ai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=supportly_ai_cookie_secret_key_2026

# AI Configuration (Google Gemini AI)
# If omitted, clean Mock AI Fallback Service automatically handles responses
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Email Configuration (SMTP Simulation)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=mock_email_user
EMAIL_PASSWORD=mock_email_pass
EMAIL_FROM=noreply@supportly.ai
